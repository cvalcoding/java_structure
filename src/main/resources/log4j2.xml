<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                    pattern="%style{%d{yyyy-MM-dd}}{yellow}  %highlight{%-5level}{FATAL=bg_red, ERROR=red, WARN=yellow, INFO=green} - %message"/>
        </Console>
        <File name="File" fileName="src/main/resources/logs/log4j.log" append="true">
            <PatternLayout>
                <Pattern>%d{HH:mm:ss} %-5level - %msg%n</Pattern>
            </PatternLayout>
        </File>
    </Appenders>
    <Loggers>
        <Logger name="com.cvalcy.javamysql" level="all"/>

        <Root level="trace">
            <AppenderRef ref="File" level="TRACE"/>
            <AppenderRef ref="Console" level="ERROR"/>
        </Root>
    </Loggers>
</Configuration>